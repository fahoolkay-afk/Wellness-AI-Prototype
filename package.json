{
  "name": "clinic-front-desk",
  "version": "0.1.0",
  "private": true,
  "description": "Unified patient inbox + AI front-desk receptionist for wellness and healthcare clinics",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.ts",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.ts",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "ehr:mock": "node --disable-warning=ExperimentalWarning src/ehr-mock.ts",
    "start:ehr": "EDITION=ehr EHR_BASE_URL=http://localhost:4000 EHR_API_KEY=dev-ehr-key node --disable-warning=ExperimentalWarning src/server.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
