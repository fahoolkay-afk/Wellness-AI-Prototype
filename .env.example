# Copy to .env and fill in. Production (the default) refuses to start until the safety
# settings below are in place. For a local demo with sample data use `npm run demo` instead.

PORT=3000
# Public HTTPS URL of this server (used for webhook URLs and Twilio signature checks).
PUBLIC_URL=https://frontdesk.example.ca
DB_PATH=data/clinic.db
# Number of reverse proxies in front of the app (0 = none). Never "true".
TRUST_PROXY_HOPS=0

# ---- Security (required) ----------------------------------------------------
# Two DIFFERENT values from `openssl rand -hex 32`. Keep them in a password manager.
# SESSION_SECRET keys the audit chain; DATA_KEY encrypts messages and transcripts at rest.
# Losing DATA_KEY makes stored messages and backups unreadable.
SESSION_SECRET=
DATA_KEY=
# Folder for encrypted nightly backups (kept 14 days).
BACKUP_DIR=data/backups
SESSION_IDLE_MINUTES=15
SESSION_MAX_HOURS=12
# Outbound texts and calls only to +1 numbers unless set to 1.
ALLOW_INTERNATIONAL_SENDS=

# ---- Edition ----------------------------------------------------------------
# standalone: this app owns patients and the calendar (partner clinics).
# ehr:        your EHRM is the source of truth (see docs/EHR_CONNECTOR_SPEC.md).
EDITION=standalone
EHR_BASE_URL=
EHR_API_KEY=
# Webhook keys are per clinic: run `npm run cli -- pair-ehr <clinicId> <locationId>`.

# ---- AI receptionist (Claude) ----------------------------------------------
# Without a key, a keyword-based demo responder is used instead.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=low
# Spend limits (denial-of-wallet protection).
AI_DAILY_TURNS_PER_CLINIC=600
AI_HOURLY_TURNS_PER_CONTACT=15

# ---- SMS: twilio or telnyx ------------------------------------------------
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# US: a Messaging Service tied to your registered 10DLC campaign.
TWILIO_MESSAGING_SERVICE_SID=
SMS_MAX_PER_CONTACT_PER_HOUR=8
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_MESSAGING_PROFILE_ID=

# ---- Meta: WhatsApp Cloud API, Messenger, Instagram ------------------------
META_GRAPH_VERSION=v23.0
META_APP_SECRET=
# 24+ random characters.
META_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
META_PAGE_ACCESS_TOKEN=

# ---- Email (general inbox) --------------------------------------------------
POSTMARK_SERVER_TOKEN=
# 24+ random characters. Postmark inbound URL: https://inbound:<this>@your-host/webhooks/email
EMAIL_INBOUND_SECRET=

# ---- Voice (ElevenLabs Agents) ---------------------------------------------
# Sent by ElevenLabs as the x-tool-secret header on tool calls and the init webhook. 24+ characters.
ELEVENLABS_TOOL_SECRET=
# HMAC secret for the post-call webhook.
ELEVENLABS_WEBHOOK_SECRET=
