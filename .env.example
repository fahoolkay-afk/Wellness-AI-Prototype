# Copy to .env and fill in what you have. Anything left blank runs in
# "simulated" mode, so the whole app works locally with no accounts at all.

PORT=3000
# Public HTTPS URL of this server (used for webhook URLs and Twilio signature checks).
PUBLIC_URL=http://localhost:3000
DB_PATH=data/clinic.db
STAFF_PASSWORD=demo
# Long random string; signs staff session cookies.
SESSION_SECRET=change-me

# ---- Edition ----------------------------------------------------------------
# standalone: this app owns patients and the calendar (partner clinics).
# ehr:        your EHRM is the source of truth (see docs/EHR_CONNECTOR_SPEC.md).
EDITION=standalone
EHR_BASE_URL=
EHR_API_KEY=
EHR_WEBHOOK_SECRET=

# ---- AI receptionist (Claude) ----------------------------------------------
# Without a key, a keyword-based demo responder is used instead.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=low

# ---- SMS: twilio or telnyx ------------------------------------------------
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_MESSAGING_PROFILE_ID=

# ---- Meta: WhatsApp Cloud API, Messenger, Instagram ------------------------
META_GRAPH_VERSION=v23.0
META_APP_SECRET=
META_VERIFY_TOKEN=clinic-verify-token
WHATSAPP_ACCESS_TOKEN=
META_PAGE_ACCESS_TOKEN=

# ---- Email (general inbox) --------------------------------------------------
POSTMARK_SERVER_TOKEN=
# Inbound webhook URL: /webhooks/email?secret=<this>
EMAIL_INBOUND_SECRET=

# ---- Voice (ElevenLabs Agents) ---------------------------------------------
# Sent by ElevenLabs as the x-tool-secret header on tool calls and the init webhook.
ELEVENLABS_TOOL_SECRET=
# HMAC secret for the post-call webhook.
ELEVENLABS_WEBHOOK_SECRET=
